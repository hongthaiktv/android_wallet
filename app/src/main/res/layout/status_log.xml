<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/status_logLayoutContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
	android:gravity="top"
	android:paddingVertical="@dimen/dialogCPVerticalSM"
	android:paddingHorizontal="@dimen/dialogCPHorizontalSM">
	
	<TextView
		android:id="@+id/status_logTvTime"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginRight="5dp"/>
	
	<ImageView
		android:id="@+id/status_logIvType"
		android:layout_width="@dimen/dialogIconSM"
		android:layout_height="@dimen/dialogIconSM"
		android:layout_marginHorizontal="@dimen/dialogIconMHorizontalSM"
		android:layout_marginTop="@dimen/dialogIconMTopSM"
		android:src="@drawable/ic_clipboard_list"/>
	
    <TextView
		android:id="@+id/status_logTvLog"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"/>
	
</LinearLayout>
