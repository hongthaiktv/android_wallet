<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<RelativeLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1">
		
		<GridLayout
			android:id="@+id/editorLayoutTop"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="13dp"
			android:columnCount="2"
			android:alignmentMode="alignBounds">
		</GridLayout>

		<LinearLayout
			android:id="@+id/editorLayoutButtons"
			android:orientation="horizontal"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:layout_marginTop="50dp"
			android:layout_below="@id/editorLayoutTop">

			<Button
				android:id="@+id/editorBtnClear"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Clear"/>

			<Button
				android:id="@+id/editorBtnAdd"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Add"
				android:layout_marginLeft="5dp"
				android:layout_marginRight="5dp"/>

			<Button
				android:id="@+id/editorBtnCancel"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Cancel"/>

		</LinearLayout>
		
		<ImageButton 
			android:id="@+id/editorIbBudget"
			android:layout_width="80dp"
			android:layout_height="40dp"
			android:layout_marginTop="7dp"
			android:layout_marginRight="7dp"
			android:padding="5dp"
			android:background="?android:attr/selectableItemBackground"
			android:scaleType="fitCenter"
			android:layout_alignParentRight="true"
			android:layout_alignParentTop="true"/>
	
	</RelativeLayout>>

</LinearLayout>

