<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res/app.web.onepagevn"
	android:id="@+id/mainLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="center_horizontal"
	android:orientation="vertical">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="@dimen/topNavHeight"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:layout_margin="5dp"
		android:paddingHorizontal="5dp"
		android:background="@color/primary">
		
		<ImageButton
			android:id="@+id/mainIbWallet"
			android:layout_width="128px"
			android:layout_height="128px"
			android:padding="5dp"
			android:background="@android:color/transparent"
			android:src="@drawable/icon_wallet"
			android:scaleType="fitCenter"/>

		<TextView
			android:id="@+id/mainTvTable"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:background="@drawable/round"
			android:backgroundTint="@color/red"
			android:textColor="@color/white"
			android:paddingHorizontal="10dp"
			android:layout_margin="5dp"
			android:gravity="center"
			android:singleLine="true"
			android:drawableLeft="@drawable/ico_dollar_sign"
			android:drawableRight="@drawable/ico_caret_down"
			android:drawablePadding="@dimen/iconDrawablePad5"
			android:drawableTint="@color/cyan"
			android:text="99.500.000"/>

		<Button
			android:id="@+id/mainBtnAdmin"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:text="Adm"
			style="?android:attr/buttonStyleSmall"
			android:drawableLeft="@drawable/ico_user"
			android:drawablePadding="@dimen/iconDrawablePad6"/>

	</LinearLayout>

	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_weight="1">
		
		<ImageView
			android:id="@+id/mainIvBGround"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:src="@drawable/bg_wallet_crypto"
			android:scaleType="fitCenter"
			android:padding="50dp"
			android:alpha="0.2"
			android:background="@drawable/bg_main"/>
		
		<app.web.onepagevn.SQLiteDBLayout
			android:id="@+id/mainTableData"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_weight="1"
			app:table="suppliers"
			app:hScroll="false"
			app:hideID="true"
			app:sql="SELECT suppliers.name AS supplier, products.name AS product, units.name AS unit, expends.price, expends.quantity, expends.price * expends.quantity AS total FROM expends INNER JOIN suppliers USING (supplierid) INNER JOIN products USING (productid) INNER JOIN units USING (unitid)">
		</app.web.onepagevn.SQLiteDBLayout>

		<LinearLayout
			android:layout_width="90dp"
			android:layout_height="90dp"
			android:layout_alignParentBottom="true"
			android:layout_alignParentEnd="true"
			android:gravity="center">

			<ImageButton
				android:id="@+id/mainIbFAB"
				android:layout_width="55dp"
				android:layout_height="55dp"
				android:tint="@color/white"
				android:scaleType="fitCenter"
				android:padding="17dp"
				android:src="@drawable/ib_fab"
				android:background="@drawable/circle"/>

		</LinearLayout>

	</RelativeLayout>

</LinearLayout>

