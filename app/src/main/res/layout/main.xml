<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res/app.web.onepagevn"
	android:id="@+id/mainLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="center_horizontal"
	android:orientation="vertical">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="@dimen/topNavHeight"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:layout_margin="5dp"
		android:paddingHorizontal="5dp"
		android:background="@color/primary">
		
		<ImageButton
			android:id="@+id/mainIbWallet"
			android:layout_width="128px"
			android:layout_height="128px"
			android:padding="5dp"
			android:background="?android:attr/selectableItemBackground"
			android:src="@drawable/icon_wallet"
			android:scaleType="fitCenter"/>

		<Button
			android:id="@+id/mainBtnTable"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:background="@drawable/btn_rounded"
			android:backgroundTint="@color/red"
			android:textColor="@color/white"
			android:paddingHorizontal="10dp"
			android:layout_margin="5dp"
			android:gravity="center"
			android:singleLine="true"
			android:drawableLeft="@drawable/ico_dollar_sign"
			android:drawableRight="@drawable/ico_caret_down"
			android:drawablePadding="@dimen/iconDrawablePad5"
			android:drawableTint="@color/cyan"/>

		<Button
			android:id="@+id/mainBtnAdmin"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:text="Adm"
			style="?android:attr/buttonStyleSmall"
			android:drawableLeft="@drawable/ico_user"
			android:drawablePadding="@dimen/iconDrawablePad6"/>

	</LinearLayout>

	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_weight="1">
		
		<ImageView
			android:id="@+id/mainIvBGround"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:src="@drawable/bg_wallet_crypto"
			android:scaleType="fitCenter"
			android:padding="50dp"
			android:background="@drawable/bg_main"
			android:alpha="0.3"/>
		
		<app.web.onepagevn.SQLiteDBLayout
			android:id="@+id/mainTableTodos"
			android:layout_width="match_parent"
			android:layout_height="118dp"
			android:layout_marginHorizontal="5dp"
			app:table="todos"
			app:title="TODO"
			app:hScroll="false"
			app:hideID="true"
			app:hideHeader="true"
			app:hideOrder="true"
			app:expandLastColumn="false"
			app:autoLoad="false"
			app:striped="false"
			app:hideTitle="false"
			app:sql="SELECT todos.todoid, priorities.priorityid AS priority, todos.job, todos.complete FROM todos INNER JOIN priorities USING (priorityid) ORDER BY todos.complete, todos.priorityid, todos.completedate DESC">
		</app.web.onepagevn.SQLiteDBLayout>
		
		<app.web.onepagevn.SQLiteDBLayout
			android:id="@+id/mainTableData"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginHorizontal="5dp"
			android:layout_weight="1"
			app:table="balance"
			app:title="BALANCE"
			app:hScroll="false"
			app:hideID="true"
			app:hideHeader="true"
			app:expandLastColumn="false"
			app:autoLoad="false"
			android:layout_below="@id/mainTableTodos">
		</app.web.onepagevn.SQLiteDBLayout>

		<LinearLayout
			android:layout_width="90dp"
			android:layout_height="90dp"
			android:layout_alignParentBottom="true"
			android:layout_alignParentEnd="true"
			android:gravity="center">

			<ImageButton
				android:id="@+id/mainIbFAB"
				android:layout_width="55dp"
				android:layout_height="55dp"
				android:tint="@color/white"
				android:scaleType="fitCenter"
				android:padding="17dp"
				android:src="@drawable/ib_fab"
				android:background="@drawable/btn_circle"/>

		</LinearLayout>

	</RelativeLayout>

</LinearLayout>

