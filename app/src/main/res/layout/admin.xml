<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res/app.web.onepagevn"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:id="@+id/adminMain">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:gravity="center">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<EditText
				android:id="@+id/admEdtInput"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:singleLine="true"/>

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<Button
					android:id="@+id/admBtnUp"
					android:layout_width="wrap_content"
					android:layout_height="35dp"
					style="?android:attr/buttonStyleSmall"
					android:text="▲"/>

				<Button
					android:id="@+id/admBtnDown"
					android:layout_width="wrap_content"
					android:layout_height="35dp"
					style="?android:attr/buttonStyleSmall"
					android:text="▼"/>

			</LinearLayout>

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center">
		
			<Button
				android:id="@+id/admBtnLogSize"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Log Size"/>

			<Button
				android:id="@+id/admBtnSQL"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="SQL"/>

			<Button
				android:id="@+id/admBtnTable"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Table"/>
			
			<Button
				android:id="@+id/admBtnLayout"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Layout"/>
		
		</LinearLayout>

	</LinearLayout>
	
	<app.web.onepagevn.SQLiteDBLayout
		android:id="@+id/admTableData"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_weight="1"
		app:table="logs"
		app:hScroll="false"
		app:hideID="true"
		app:sql="SELECT id, iif(strftime('%Y', timestamp, 'unixepoch', 'localtime') = strftime('%Y', 'now', 'localtime'), strftime('%d-%m %T', timestamp, 'unixepoch', 'localtime'), strftime('%d-%m-%Y %T', timestamp, 'unixepoch', 'localtime')) AS timestamp, message FROM logs ORDER BY timestamp DESC LIMIT 100">
	</app.web.onepagevn.SQLiteDBLayout>

</LinearLayout>
